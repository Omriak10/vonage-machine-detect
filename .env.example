# ---- Vonage (required) ----
# Your Vonage Voice application id (dashboard > Applications)
VONAGE_APPLICATION_ID=00000000-0000-0000-0000-000000000000
# A Vonage voice-enabled number on your account, used as the caller id (digits only, E.164 without +)
VONAGE_FROM=447700900000
# The public HTTPS base URL this app is reachable at (your VCR instance URL, no trailing slash)
PUBLIC_BASE=https://your-instance.euw1.runtime.vonage.cloud
# Your application private key. Either paste the PEM here (use \n for newlines)...
# VONAGE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# ...or ship the key as a file and point to it (default: ./private.key)
VONAGE_PRIVATE_KEY_PATH=./private.key

# Optional: your application signature secret - enables webhook signature verification
# VONAGE_SIGNATURE_SECRET=

# ---- Salesforce (optional) ----
# Leave blank to run without Salesforce. Fill in to enable call lists + activity logging.
# Connected App with the OAuth 2.0 Client Credentials flow enabled.
SF_LOGIN_URL=https://your-domain.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
